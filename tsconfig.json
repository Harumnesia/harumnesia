{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@harumnesia/recommender": ["./packages/recommender/src/index.ts"],
      "@harumnesia/shared": ["./packages/shared/src/index.ts"]
    },
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "apps/web/src",
    "apps/web/vite.config.ts",
    "packages/*/src",
    "packages/*/tests",
    "vitest.config.ts"
  ]
}
